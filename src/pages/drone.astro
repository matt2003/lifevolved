---
import Base from '../layouts/Base.astro';
import { dronePhotos, droneVideos, droneAlbums, droneGear, flickrProfile } from '../data/media';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = droneAlbums
  .map(a => ({ ...a, photos: dronePhotos.filter(p => p.album === a.name) }))
  .filter(a => a.photos.length > 0);
---
<Base title="Drone">
  <h1>Drone</h1>
  <p class="muted">Aerial photography over Thasos, Greece. Full galleries on <a href={flickrProfile}>Flickr</a>.</p>
  <p>{droneGear.map(g => <span class="tag" title={g.note}>{g.name}</span>)}</p>

  {sections.map(a => (
    <section>
      <h2>{a.name} <a class="more" href={a.url}>View album on Flickr</a></h2>
      <div class="gallery">
        {a.photos.map(p => (
          <a href={p.flickr} class="shot"><img src={`${base}${p.src}`} alt={`${a.name}, Thasos ${p.year}`} loading="lazy" /></a>
        ))}
      </div>
    </section>
  ))}

  {droneVideos.length > 0 && (
    <section>
      <h2>Videos</h2>
      <div class="grid">
        {droneVideos.map(v => (
          <div class="card"><div class="video"><iframe src={`https://www.youtube-nocookie.com/embed/${v.youtubeId}`} title={v.title} loading="lazy" allowfullscreen></iframe></div><p>{v.title}</p></div>
        ))}
      </div>
    </section>
  )}
</Base>

<style>
  .more { font-size: .85rem; font-weight: 400; margin-left: .6rem; }
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .6rem; }
  .shot { display: block; overflow: hidden; border-radius: 10px; aspect-ratio: 4 / 3; background: var(--card); }
  .shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .4s; }
  .shot:hover img { transform: scale(1.05); }
</style>
